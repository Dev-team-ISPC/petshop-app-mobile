<?xml version="1.0" encoding="utf-8"?>
<!-- Nueva vacuna del catálogo — sólo veterinario -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView style="@style/Etiqueta" android:labelFor="@id/campoNombre" android:text="@string/campo_nombre" />
        <EditText
            android:id="@+id/campoNombre"
            style="@style/Campo"
            android:hint="@string/hint_nombre_vacuna"
            android:importantForAutofill="no"
            android:inputType="textCapWords" />

        <TextView style="@style/Etiqueta" android:labelFor="@id/campoDescripcion" android:text="@string/campo_descripcion" />
        <EditText
            android:id="@+id/campoDescripcion"
            style="@style/Campo"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="@string/hint_descripcion_vacuna"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:minHeight="96dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />

        <TextView style="@style/Etiqueta" android:labelFor="@id/campoFrecuencia" android:text="@string/campo_frecuencia_meses" />
        <EditText
            android:id="@+id/campoFrecuencia"
            style="@style/Campo"
            android:layout_marginBottom="4dp"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="3" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/ayuda_frecuencia"
            android:textColor="@color/texto_suave"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonGuardar"
            style="@style/BotonPrimario"
            android:text="@string/accion_guardar" />

        <ProgressBar
            android:id="@+id/progreso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
