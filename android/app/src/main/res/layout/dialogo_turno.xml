<?xml version="1.0" encoding="utf-8"?>
<!-- Acciones sobre un turno: se muestran sólo las que corresponden al rol y al estado -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/fondo_tarjeta_cerrada"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/servicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texto"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_medio"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/estadoActual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/pendiente_texto"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botonConfirmar"
        style="@style/BotonPrimario"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:text="@string/accion_confirmar_y_tomar"
        android:textSize="15sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botonCompletar"
        style="@style/BotonSecundario"
        android:layout_marginTop="10dp"
        android:text="@string/accion_marcar_completado"
        android:textColor="@color/texto_medio"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botonCancelar"
        style="@style/BotonSecundario"
        android:layout_marginTop="10dp"
        android:text="@string/accion_cancelar_el_turno"
        android:textColor="@color/peligro"
        android:visibility="gone"
        app:strokeColor="@color/peligro_borde" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botonEliminar"
        style="@style/BotonSecundario"
        android:layout_marginTop="10dp"
        android:text="@string/accion_eliminar_turno"
        android:textColor="@color/peligro"
        android:visibility="gone"
        app:strokeColor="@color/peligro_borde" />

    <TextView
        android:id="@+id/nota"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/texto_medio"
        android:textSize="13sp" />
</LinearLayout>
