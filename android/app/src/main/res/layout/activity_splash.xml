<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash — primera pantalla de la app.

  Accesibilidad (RNF13 / WCAG 2.2 AA):
  - Texto blanco puro sobre azul: contraste 5,17:1 (mínimo 4,5:1).
  - Huella decorativa: importantForAccessibility="no".
  - Aviso de conexión anunciado por TalkBack (accessibilityLiveRegion).
  - Tamaños en sp: respeta la fuente máxima del sistema.

  Los Space con peso reparten el alto disponible: en horizontal la marca y el
  aviso no se superponen, y si no entran, el ScrollView permite desplazarse.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/azul"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="24dp"
        android:paddingEnd="32dp"
        android:paddingBottom="32dp">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/contenedorMarca"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_huella" />

            <TextView
                android:id="@+id/textoTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/app_name"
                android:textColor="@color/blanco"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/splash_subtitulo"
                android:textColor="@color/blanco"
                android:textSize="16sp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:minHeight="72dp"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/progreso"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:indeterminateTint="@color/blanco"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textoEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:text="@string/splash_despertando"
                android:textColor="@color/blanco"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
