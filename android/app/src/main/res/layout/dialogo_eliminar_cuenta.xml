<?xml version="1.0" encoding="utf-8"?>
<!-- Contenido del diálogo de baja: hay que escribir ELIMINAR para habilitar el botón -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/msg_eliminar_cuenta_detalle"
        android:textColor="@color/texto_medio"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/fondo_zona_riesgo"
        android:padding="12dp"
        android:text="@string/msg_no_se_puede_deshacer"
        android:textColor="@color/peligro"
        android:textSize="14sp" />

    <TextView
        style="@style/Etiqueta"
        android:layout_marginTop="16dp"
        android:labelFor="@id/campoConfirmacion"
        android:text="@string/etiqueta_confirmar_eliminar" />

    <EditText
        android:id="@+id/campoConfirmacion"
        style="@style/Campo"
        android:hint="@string/palabra_eliminar"
        android:importantForAutofill="no"
        android:inputType="textCapCharacters" />
</LinearLayout>
