<?xml version="1.0" encoding="utf-8"?>
<!-- Alta y edición de mascota — RF03 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView style="@style/Etiqueta" android:labelFor="@id/campoNombre" android:text="@string/campo_nombre" />
        <EditText
            android:id="@+id/campoNombre"
            style="@style/Campo"
            android:hint="@string/hint_nombre_mascota"
            android:importantForAutofill="no"
            android:inputType="textPersonName|textCapWords" />

        <TextView style="@style/Etiqueta" android:labelFor="@id/campoEspecie" android:text="@string/campo_especie" />
        <Spinner
            android:id="@+id/campoEspecie"
            style="@style/Campo"
            android:contentDescription="@string/campo_especie" />

        <TextView style="@style/Etiqueta" android:labelFor="@id/campoRaza" android:text="@string/campo_raza" />
        <EditText
            android:id="@+id/campoRaza"
            style="@style/Campo"
            android:hint="@string/hint_raza"
            android:importantForAutofill="no"
            android:inputType="textCapWords" />

        <TextView style="@style/Etiqueta" android:labelFor="@id/campoPeso" android:text="@string/campo_peso" />
        <EditText
            android:id="@+id/campoPeso"
            style="@style/Campo"
            android:layout_marginBottom="4dp"
            android:digits="0123456789,."
            android:hint="@string/hint_peso"
            android:importantForAutofill="no"
            android:inputType="numberDecimal" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/ayuda_peso"
            android:textColor="@color/texto_suave"
            android:textSize="13sp" />

        <TextView style="@style/Etiqueta" android:labelFor="@id/campoFecha" android:text="@string/campo_fecha_nacimiento" />
        <EditText
            android:id="@+id/campoFecha"
            style="@style/Campo"
            android:clickable="true"
            android:cursorVisible="false"
            android:drawableEnd="@android:drawable/ic_menu_my_calendar"
            android:focusableInTouchMode="false"
            android:hint="@string/hint_fecha"
            android:importantForAutofill="no"
            android:inputType="none"
            android:layout_marginBottom="4dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/ayuda_fecha_nacimiento"
            android:textColor="@color/texto_suave"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/ayudaDueno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/fondo_tarjeta"
            android:padding="12dp"
            android:text="@string/msg_dueno_automatico"
            android:textColor="@color/texto_medio"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonGuardar"
            style="@style/BotonPrimario"
            android:text="@string/accion_guardar" />

        <!-- Sólo el dueño, en la edición -->
        <LinearLayout
            android:id="@+id/zonaEliminar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/fondo_zona_riesgo"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/msg_eliminar_mascota_detalle"
                android:textColor="@color/texto_medio"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonEliminar"
                style="@style/BotonSecundario"
                android:layout_marginTop="12dp"
                android:text="@string/accion_eliminar_mascota"
                android:textColor="@color/peligro"
                app:strokeColor="@color/peligro_borde" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progreso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
