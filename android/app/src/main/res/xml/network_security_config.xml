<?xml version="1.0" encoding="utf-8"?>
<!--
  La API de desarrollo va por HTTP sin cifrar. Android 9+ lo bloquea por
  defecto, así que lo habilitamos SÓLO para las direcciones locales.
  Todo el resto del tráfico sigue exigiendo HTTPS, que es lo que pide el
  requisito de SSL/TLS para el entorno desplegado.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- La máquina anfitriona vista desde el emulador -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
