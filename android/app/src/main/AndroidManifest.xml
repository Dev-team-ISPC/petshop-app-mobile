<?xml version="1.0" encoding="utf-8"?>
<!--
  Este archivo ya esta completo: las 14 Activities estan declaradas, cada una
  con su parentActivityName. Nadie deberia tener que editarlo para desarrollar
  su pantalla, y ese es justamente el punto: si lo tocan seis personas a la vez,
  cada merge es un conflicto.

  El parentActivityName es lo que hace que la flecha de retorno funcione y
  vuelva siempre al lugar correcto, que es un requisito explicito del enunciado.

  Si tu pantalla necesita algo que no esta declarado aca, avisa en el grupo
  antes de tocarlo.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Petshop"
        tools:targetApi="n">

        <!-- ================= 1 · Acceso ================= -->

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.Petshop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.RegistroActivity"
            android:exported="false"
            android:label="@string/titulo_registro"
            android:parentActivityName=".ui.auth.LoginActivity"
            android:theme="@style/Theme.Petshop.ConBarra" />

        <!-- ================= 2 · Inicio ================= -->

        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false"
            android:label="@string/titulo_home"
            android:theme="@style/Theme.Petshop.ConBarra" />

        <!-- ================= 3 · Mascotas y carnet ================= -->

        <activity
            android:name=".ui.mascota.MascotasActivity"
            android:exported="false"
            android:label="@string/titulo_mascotas"
            android:parentActivityName=".ui.home.HomeActivity"
            android:theme="@style/Theme.Petshop.ConBarra" />

        <activity
            android:name=".ui.mascota.MascotaFormActivity"
            android:exported="false"
            android:label="@string/titulo_mascota_nueva"
            android:parentActivityName=".ui.mascota.MascotasActivity"
            android:theme="@style/Theme.Petshop.ConBarra" />

        <activity
            android:name=".ui.carnet.CarnetActivity"
            android:exported="false"
            android:label="@string/titulo_carnet"
            android:parentActivityName=".ui.mascota.MascotasActivity"
            android:theme="@style/Theme.Petshop.ConBarra" />

        <!-- ================= 4 · Turnos y vacunación ================= -->

        <activity
            android:name=".ui.turno.TurnoFormActivity"
            android:exported="false"
            android:label="@string/titulo_turno_nuevo"
            android:parentActivityName=".ui.carnet.CarnetActivity"
            android:theme="@style/Theme.Petshop.ConBarra" />

        <activity
            android:name=".ui.vacunacion.VacunacionFormActivity"
            android:exported="false"
            android:label="@string/titulo_vacunacion_nueva"
            android:parentActivityName=".ui.carnet.CarnetActivity"
            android:theme="@style/Theme.Petshop.ConBarra" />

        <activity
            android:name=".ui.agenda.AgendaActivity"
            android:exported="false"
            android:label="@string/titulo_agenda"
            android:parentActivityName=".ui.home.HomeActivity"
            android:theme="@style/Theme.Petshop.ConBarra" />

        <!-- ================= 5 · Cuenta y público ================= -->

        <activity
            android:name=".ui.perfil.PerfilActivity"
            android:exported="false"
            android:label="@string/titulo_perfil"
            android:parentActivityName=".ui.home.HomeActivity"
            android:theme="@style/Theme.Petshop.ConBarra" />

        <activity
            android:name=".ui.publico.ContactoActivity"
            android:exported="false"
            android:label="@string/titulo_contacto"
            android:parentActivityName=".ui.home.HomeActivity"
            android:theme="@style/Theme.Petshop.ConBarra" />

        <!-- La Activity con el recurso multimedia que pide el enunciado -->
        <activity
            android:name=".ui.publico.QuienesSomosActivity"
            android:exported="false"
            android:label="@string/titulo_quienes_somos"
            android:parentActivityName=".ui.home.HomeActivity"
            android:theme="@style/Theme.Petshop.ConBarra" />

        <!-- ================= 6 · Administración ================= -->

        <activity
            android:name=".ui.admin.UsuariosActivity"
            android:exported="false"
            android:label="@string/titulo_usuarios"
            android:parentActivityName=".ui.home.HomeActivity"
            android:theme="@style/Theme.Petshop.ConBarra" />

        <activity
            android:name=".ui.admin.ServiciosActivity"
            android:exported="false"
            android:label="@string/titulo_servicios"
            android:parentActivityName=".ui.home.HomeActivity"
            android:theme="@style/Theme.Petshop.ConBarra" />

    </application>
</manifest>
