                "registro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nuevo@petshop.test\",\n  \"nombre\": \"Nuevo Usuario\",\n  \"telefono\": \"3510000000\",\n  \"direccion\": \"Calle 123\",\n  \"password\": \"Petshop2026!\",\n  \"acepta_terminos\": true\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login (cliente)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login/",
