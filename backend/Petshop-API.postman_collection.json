              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente@petshop.test\",\n  \"password\": \"Petshop2026!\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "pm.environment.set('access', d.access);",
                  "pm.environment.set('refresh', d.refresh);",
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
