# Copiar a .env y completar. El .env NO se versiona.

SECRET_KEY=generar-una-clave-propia
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2

# Origenes autorizados (Angular en desarrollo). Android no necesita CORS.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

DB_NAME=petshop
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7

# Solo en el entorno desplegado. Si esta presente, tiene prioridad sobre DB_*.
DATABASE_URL=
DB_SSL_CA=ca.pem
CSRF_TRUSTED_ORIGINS=https://petshop-api.onrender.com